#!/bin/bash
#
#
current_ip=$(hostname -I)
site=$(cat /opt/wellpass/site_name)
release=$(cat /opt/wellpass/version)
#TESTING_SERVER=$(cat /opt/wellpass/server_id)
#
if [[ $(/usr/bin/id -u) -ne 0 ]]; then
    echo "Not running with sufficient permissions, please use sudo."
    exit
fi
#
# Create a visual menu box
CHOICE=$(whiptail --title "- $HOSTNAME - $site -" --ok-button "Run Choice" --cancel-button "Exit Menu" --clear --menu "\nWellPass Diagnostics V$release\nServer IP Address's: $current_ip \nChoose an option:" 21 64 10 \
"1" "Check WiFi Signal" \
"2" "Configure Network Settings" \
"3" "Change Sitename" \
"4" "Change UniFi Address" \
"5" "Restart Browser" \
"6" "PI Process Monitor" \
"7" "Configure Raspberry-PI" \
"8" "Update and Upgrade Software" \
"9" "Shutdown Device" \
"10" "Reboot Device" 3>&1 1>&2 2>&3) 

# Handle the user choice based on exit status and selection
if [ $? -eq 0 ]; then
case $CHOICE in
1) wavemon ;;
2) nmtui ;;
3) sudo change_sitename ;;
4) sudo change_unifi ;;
5) restart_browser ;;
6) sudo btop ;;
7) sudo raspi-config ;;
8) sudo apt-get update && sudo apt-get autoremove -y && sudo apt-get dist-upgrade -y ;;
9) clear ; echo "Power Off in 10 seconds... CTRL+C to abort" ; sleep 10 ; poweroff ;;
10) clear ; echo "Rebooting in 5 seconds... CTRL+C to abort" ; sleep 5 ; reboot ;;
esac
#
# Return to menu
#
/usr/bin/wp-diagnostics
#
else
echo "Menu exited user."
fi

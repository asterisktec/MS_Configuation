# change url as your needs
URL="https://10.10.1.70"   # dont put spaces near =

xset s on         # disable or enable screensaver
xset s blank      # blank the screen
xset s 60         # blank screen after 60 seconds
xset -dpms        # enable/disable powesave sleep modes

# Disable Function Keys
xmodbmap -e 'keycode 67='

# Start VNC Session
x11vnc -display :0 -rfbauth .vnc/passwd -forever -loop -repeat &

# Optional: set graphic resolutionand eventually screen rotation 90° left
#xrandr --output HDMI-1 --mode 1280x1024 --rotate left

# Optional: allows you to close the X server by pressing CTRL-ALT-Backspace
# setxkbmap -option terminate:ctrl_alt_bksp

# Launch Chromium in kiosk mode
sed -i 's/"exited_cleanly":false/"exited_cleanly":true/' ~/.config/chromium/'Local State'
sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]\+"/"exit_type":"Normal"/' ~/.config/chromium/Default/Preferences
chromium --disable-infobars \
  --disk-cache-size=1 \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --disable-features=MediaSessionService \
  --kiosk "$URL"

#!/bin/bash
#
clear
#
if [[ $(/usr/bin/id -u) -ne 0 ]]; then
    echo "Not running with sufficient permissions, please use sudo."
    exit
fi
#
echo "Updating the UniFi IP Address"
echo ""
read -p "Enter the new UniFi Address: " sitename
#
sitename="${sitename//[$'\n']/}"
#
printf "$sitename" > /opt/wellpass/unifi_ip
#
echo ""
echo "Site Name has been updated to $sitename as requested."
echo "" ; sleep 2
#

#
killall chromium
#
IP_ADDR=$(cat /opt/wellpass/unifi_ip)
#
URL="https://$IP_ADDR"   # dont put spaces near =https://github.com/asterisktec/MS_Configuation/tree/main/opt/wellpass
#
#
# Launch Chromium in kiosk mode
#
DISPLAY=:0 chromium --disable-infobars \
  --disk-cache-size=1 \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --disable-features=MediaSessionService \
  --kiosk "$URL" 3>&1 1>&2 2>&3 &
